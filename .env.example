# Odoo (opcional: dejar ODOO_API_ENABLED=false para usar CSV/Excel)
ODOO_API_ENABLED=false
ODOO_URL=https://tu-instancia.odoo.com
ODOO_DB=tu_base_de_datos
ODOO_USER=tu_usuario
ODOO_PASSWORD=tu_contrasena

# Gemini es opcional y no bloquea el procesamiento local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
